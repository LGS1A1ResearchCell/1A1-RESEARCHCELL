# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# env: keep the example committed, never real credentials
!.env.example

# supabase local artefacts
/supabase/.temp
/supabase/.branches

# Local verification scripts. Hold development credentials; never committed.
/tests-local

# Local environment launcher. Names the Testing Supabase project and reads its
# credentials from .env.testing.local, so it stays out of the repository — the
# published history contains no Supabase project identifier and must not start.
/scripts/use-testing-env.ps1
